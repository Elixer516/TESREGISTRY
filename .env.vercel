# Production settings for the Vercel site (the shared Supabase database).
# Read only by `npm run build:vercel` (vite --mode vercel), which vercel.json
# runs. GitHub Pages builds with the default mode, never reads this file, and
# so stays the in-browser demo. Every value here is public by design: the
# publishable key goes to every visitor's browser; the secret key never
# leaves Supabase.
VITE_SUPABASE_URL=https://keetvprldtxymkdvfngi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XPzYwuWGg75GudIALKeYJQ_3uscd0rj
VITE_DRIVE_RELAY_URL=https://script.google.com/macros/s/AKfycbx-RE7ZjyBRdgT-n_1J7LbhIiHmjfBn_yrtMo-mPrPuUOQ72Ng3ITPdDVRW_iYq4qDd/exec
